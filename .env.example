# ── LLM ────────────────────────────────────────────────────────────────
# "ollama" (local, default) or "gemini" (hosted, needs GEMINI_API_KEY)
LLM_PROVIDER=ollama
# Exactly as shown by `ollama list`
LLM_MODEL=gemma3
OLLAMA_BASE_URL=http://localhost:11434
# Context window requested from Ollama, in tokens. Bigger fits more of the
# screenplay per request but needs more RAM/VRAM. Screenplays that don't fit
# are sent as a scene outline plus the most relevant scenes.
OLLAMA_NUM_CTX=16384
# Only for LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# ── Google sign-in ─────────────────────────────────────────────────────
# Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   <APP_BASE_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web app ────────────────────────────────────────────────────────────
# Public URL of the backend. Use https:// in production (enables Secure cookies).
APP_BASE_URL=http://localhost:8000
# Where the browser lands after login. Leave unset in production (same as
# APP_BASE_URL). Set to http://localhost:5173 when running the Vite dev server.
# FRONTEND_URL=http://localhost:5173
# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# SQLite for local development (the default). Postgres in production:
#   postgresql+psycopg://user:pass@host:5432/planyourshot
# postgres:// and postgresql:// URLs (as hosts hand them out) are accepted too.
# docker-compose.yml sets this for you.
DATABASE_URL=sqlite:///data/app.db
# Postgres connection pool per process
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# Uploaded screenplay files (keep this on a persistent volume in production)
STORAGE_DIR=data/uploads

MAX_UPLOAD_MB=10

# ── Model call guards ──────────────────────────────────────────────────
# Seconds before a model call is abandoned (shown to the user as a friendly error)
LLM_TIMEOUT_SECONDS=120
# Longest reply the model may write, in tokens (num_predict for Ollama,
# max_output_tokens for Gemini)
LLM_MAX_OUTPUT_TOKENS=2000
# Model calls running at once across all users. Shot-list generation takes a
# slot per scene, so a long generation can't starve other users' chats.
MAX_CONCURRENT_LLM_CALLS=2

# ── Rate limits on routes that don't call the model ───────────────────
# Per client IP, on /api/auth/*
AUTH_RATE_LIMIT_PER_MINUTE=20
# Per user, every upload attempt counts
UPLOAD_RATE_LIMIT_PER_HOUR=10

# ── Plan limits (src/planyourshot/web/limits.py) ──────────────────────
# Every account is on the "free" plan; "pro" is configuration only for now.
# Override any value as <PLAN>_<FIELD>. Shown here with the built-in defaults.
# Message, scene and regeneration counts are rolling 24 hours; full shot-list
# generations are rolling 30 days. Failed model calls don't count; off-topic
# (refused) ones do.
# FREE_MAX_SCRIPTS=2
# FREE_MAX_SCRIPT_CHARS=45000
# FREE_MESSAGES_PER_DAY=15
# FREE_FULL_GENERATIONS_PER_MONTH=2
# FREE_SCENE_GENERATIONS_PER_DAY=5
# FREE_SHOT_REGENERATIONS_PER_DAY=10
# FREE_REQUESTS_PER_MINUTE=5
# FREE_CSV_EXPORT=0
# PRO_MAX_SCRIPTS=20
# PRO_MAX_SCRIPT_CHARS=400000
# PRO_MESSAGES_PER_DAY=200
# PRO_FULL_GENERATIONS_PER_MONTH=30
# PRO_SCENE_GENERATIONS_PER_DAY=50
# PRO_SHOT_REGENERATIONS_PER_DAY=100
# PRO_REQUESTS_PER_MINUTE=20
# PRO_CSV_EXPORT=1

# Local development only — shows an email-only sign-in on the login page.
# The app refuses to start with this on when APP_BASE_URL is https.
# AUTH_DEV_LOGIN=1

# ── Background jobs ────────────────────────────────────────────────────
# Uploads and shot generation run in a worker:  uv run python -m planyourshot.web.worker
# Run the worker inside the web process instead. Default: on for SQLite (so
# `uvicorn` alone works locally), off for Postgres (run the worker separately).
# RUN_WORKER_IN_WEB=1
# A running job with no heartbeat for this long is put back in the queue
# (its worker died). /api/health/worker reports 503 past this age too.
JOB_STALE_SECONDS=600
# Seconds between queue polls when idle, and the retry back-off base
# (attempt n waits n × this). Jobs are tried 3 times.
# JOB_POLL_SECONDS=2
# JOB_RETRY_DELAY_SECONDS=15
# Tests only: run each job synchronously when it is queued.
# RUN_JOBS_INLINE=0

# ── Monitoring and admin ───────────────────────────────────────────────
# Error tracking with Sentry, off unless set. No request bodies, cookies,
# screenplay text, chat content or email addresses are sent.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# Frontend DSN: read at *build* time (docker build --build-arg VITE_SENTRY_DSN=...,
# or `VITE_SENTRY_DSN=... npm run build`). The backend reads it too, to allow it in the CSP.
# VITE_SENTRY_DSN=
# Comma-separated emails that can open /admin (404 for everyone else)
# ADMIN_EMAILS=you@example.com
# Where the Terms and Privacy markdown lives (default: legal/ in the repo)
# LEGAL_DIR=legal

# ── Offline RAG experiments (planyourshot.knowledge_base, not used by the web app) ──
# EMBED_MODEL=nomic-embed-text
# CHROMA_DIR=data/chroma
